[Unit]
Description=Printora Cloud
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
WorkingDirectory=/var/www/print3dmaker.xyz/current/backend
EnvironmentFile=/var/www/print3dmaker.xyz/shared/printora-cloud.env
ExecStart=/var/www/print3dmaker.xyz/shared/venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8069 --loop asyncio
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
