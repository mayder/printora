[Unit]
Description=Valida prontidão de recuperação do Printora Cloud
After=postgresql@16-printora.service
OnFailure=printora-cloud-recovery-alert@%n.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/printora-cloud/recovery-readiness.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/printora-cloud /var/lib/postgresql/16/printora-wal-archive
MemoryMax=256M
CPUQuota=25%
TasksMax=32
TimeoutStartSec=30
