[Unit]
Description=Printora
After=network-online.target moonraker.service
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/Printora
EnvironmentFile=-/home/pi/Printora/.env
ExecStart=/home/pi/Printora/scripts/run_app.sh --foreground --no-open
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
