[Unit]
Description=Registra alerta de recuperação do Printora Cloud para %I

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/printora-cloud/emit-recovery-alert.sh %I
StateDirectory=printora-cloud
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/printora-cloud
MemoryMax=128M
CPUQuota=20%
TasksMax=16
RuntimeMaxSec=20
