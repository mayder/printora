[Unit]
Description=Retenção local de WAL com custódia externa verificada
After=network-online.target postgresql@16-printora.service
OnFailure=printora-cloud-recovery-alert@%n.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/printora-cloud/retain-postgresql-wal.sh --apply
RuntimeDirectory=printora-wal-retention
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/postgresql/16/printora-wal-archive /var/lib/printora-cloud /var/www/print3dmaker.xyz/shared/backup-cache
InaccessiblePaths=/var/lib/postgresql/16/printora/pg_wal
MemoryMax=2G
CPUQuota=50%
CPUWeight=10
IOWeight=10
Nice=15
TasksMax=64
TimeoutStartSec=600
