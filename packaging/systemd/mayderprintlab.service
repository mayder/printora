[Unit]
Description=MayderPrintLab
After=network-online.target moonraker.service
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/MayderPrintLab/backend
EnvironmentFile=-/home/pi/MayderPrintLab/.env
ExecStart=/home/pi/MayderPrintLab/backend/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8085
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
