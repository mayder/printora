[Unit]
Description=Printora isolated analytics and intelligence consumer
After=network-online.target postgresql@16-printora.service
Wants=network-online.target postgresql@16-printora.service

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/var/www/print3dmaker.xyz/current/backend
EnvironmentFile=/var/www/print3dmaker.xyz/shared/printora-cloud.env
EnvironmentFile=/etc/printora-cloud/postgresql.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/var/www/print3dmaker.xyz/current/venv/bin/python -m app.intelligence_worker
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
Nice=10
CPUQuota=50%
MemoryHigh=512M
MemoryMax=1G
TasksMax=128
IOWeight=25
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/print3dmaker.xyz/shared

[Install]
WantedBy=multi-user.target
