[Unit]
Description=Sincroniza WAL PostgreSQL do Printora Cloud com custódia externa
After=network-online.target postgresql@16-printora.service
Wants=network-online.target
OnFailure=printora-cloud-recovery-alert@%n.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/printora-cloud/sync-postgresql-wal.sh
StateDirectory=printora-cloud
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/postgresql/16/printora-wal-archive
ReadWritePaths=/var/lib/printora-cloud /var/www/print3dmaker.xyz/shared/backup-cache
MemoryMax=1G
CPUQuota=50%
CPUWeight=10
IOWeight=10
Nice=10
TasksMax=64
RuntimeMaxSec=110
